# Turns src/boot_script.js into a C string the host can inject. The file is not
# compiled as a program. Check-Contracts.ps1 rejects it as a compiled source line.
# MSVC rejects a single literal past 16380 characters, so the text is split.
if(NOT INPUT OR NOT OUTPUT)
    message(FATAL_ERROR "embed_boot.cmake needs -DINPUT= and -DOUTPUT=")
endif()
if(NOT SYMBOL)
    set(SYMBOL kBootScript)
endif()
file(READ "${INPUT}" TEXT)
if(TEXT MATCHES "\\)DOOMNET_BOOT_RAW")
    message(FATAL_ERROR "boot_script.js contains the raw-string delimiter DOOMNET_BOOT_RAW")
endif()
set(CHUNK 8000)
string(LENGTH "${TEXT}" TOTAL)
set(BODY "static const char ${SYMBOL}[] =\n")
set(OFFSET 0)
while(OFFSET LESS TOTAL)
    math(EXPR END "${OFFSET} + ${CHUNK}")
    if(END GREATER TOTAL)
        set(END ${TOTAL})
    endif()
    math(EXPR LEN "${END} - ${OFFSET}")
    string(SUBSTRING "${TEXT}" ${OFFSET} ${LEN} PART)
    string(APPEND BODY "R\"DOOMNET_BOOT_RAW(${PART})DOOMNET_BOOT_RAW\"\n")
    set(OFFSET ${END})
endwhile()
string(APPEND BODY ";\n")
file(WRITE "${OUTPUT}" "${BODY}")
